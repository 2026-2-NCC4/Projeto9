# NÃO envie um arquivo secrets.toml com dados reais ao GitHub.
# O cadastro local com SQLite funciona mesmo sem este arquivo.

[auth]
username = ""
password = ""
allow_demo = false
allow_signup = true
# Para manter cadastros no Streamlit Cloud, configure PostgreSQL persistente:
# database_url = "postgresql://USUARIO:SENHA@HOST:5432/BANCO?sslmode=require"

# OPCIONAL: recuperação por e-mail, caso exista um serviço SMTP.
# A recuperação pela chave guardada funciona sem configurar esta seção.
# Use a senha de aplicativo ou a credencial fornecida pelo seu serviço SMTP.
[smtp]
host = ""
port = 587
username = ""
password = ""
from_email = ""
# false: STARTTLS (normalmente porta 587); true: TLS implícito (porta 465).
use_ssl = false
